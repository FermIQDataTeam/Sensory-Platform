{
  "name": "sensory-platform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "vite build && node scripts/check-bundle-budget.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:runtime": "node scripts/check-runtime-baseline.mjs",
    "verify:evidence-assist": "node scripts/verify-evidence-assist.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:demo-boundaries": "vitest run src/app/data/demo-boundaries.test.ts",
    "test:migration-drift": "bash scripts/test-migration-drift.sh",
    "test:rls:local": "bash scripts/run-local-rls-tests.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "db:types": "supabase gen types typescript --linked --schema public --schema graphql_public > src/app/lib/db/database.types.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "@sentry/react": "^10.56.0",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "exceljs": "^4.4.0",
    "fflate": "0.8.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "1.33.0",
    "pdfjs-dist": "^6.2.108",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-qr-code": "^2.2.0",
    "react-router": "7.18.2",
    "recharts": "2.15.2",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "6.3.5",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "brace-expansion@>=4 <6": "5.0.9",
      "dompurify@<=3.4.12": "3.4.13",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
